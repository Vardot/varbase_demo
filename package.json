    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "Demo"
  ],
  "author": "Vardot",
  "dependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@cucumber/pretty-formatter": "^1.0.0",
    "@vardot/varbase-e2e": "^2.0.8",
    "playwright": "^1.60.0",
    "tsx": "^4.22.1"
  },
  "resolutions": {
    "@cucumber/pretty-formatter": "1.0.0",
    "playwright": "1.60.0"
  },
  "devDependencies": {
    "cspell": "^8.16.1",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2"
  },
  "packageManager": "yarn@4.18.1"
}
