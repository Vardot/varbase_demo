{
  "name": "varbase_demo",
  "description": "Varbase Demo - demo content for Varbase projects.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "engines": {
    "yarn": ">= 4.18.1",
    "node": ">= 24.0"
  },
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "eslint --ext .js .",
    "lint:yaml": "eslint --ext .yml .",
    "spellcheck": "cspell lint .",
    "test": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:chromium": "BROWSER=chromium node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "generate-reports": "node ./node_modules/@vardot/varbase-e2e/bin/generate-reports.js"
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "Demo"
  ],
  "author": "Vardot",
  "dependencies": {
    "@vardot/varbase-e2e": "^2.0.8"
  },
  "devDependencies": {
    "cspell": "^8.16.1",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2"
  },
  "packageManager": "yarn@4.18.1"
}
